# === REQUIRED ===

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_CHAT_ID=your_telegram_user_id

# MRKT API
MRKT_AUTH_TOKEN=your_mrkt_authorization_token

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mrkt_bot

# === OPTIONAL (Getgems / Fragment / Transfers) ===

# TON wallet mnemonic (24 words) — for Getgems/Fragment auth
WALLET_MNEMONIC=word1 word2 ... word24

# Getgems
GETGEMS_API_KEY=
GETGEMS_CDP_URL=http://localhost:29229

# Fragment
FRAGMENT_API_KEY=
FRAGMENT_COOKIES=

# Portal Market (portal-market.com)
# TMA init data for authenticated operations (buy/sell/withdraw)
PORTAL_TMA_INIT_DATA=

# Telegram session (for gift transfers via Telethon)
TELEGRAM_SESSION=

# Redis (optional — falls back to PG locks if empty)
REDIS_URL=

# === TRADING SETTINGS ===

MIN_ROI_PERCENT=10
MIN_ABSOLUTE_PROFIT_TON=0.5
MIN_CONFIDENCE=0.3
MAX_TRADE_AMOUNT_TON=0

# Fees (percent)
MRKT_BUY_FEE_PCT=0.0
MRKT_SELL_FEE_PCT=5.0
GETGEMS_SELL_FEE_PCT=0.0

# Withdrawal fees (TON)
MRKT_WITHDRAW_FEE_TON=0.2
GETGEMS_WITHDRAW_FEE_TON=0.3
FRAGMENT_WITHDRAW_FEE_TON=0.0
PORTAL_WITHDRAW_FEE_TON=0.25

# === RISK LIMITS ===

MAX_TOTAL_EXPOSURE_TON=600.0
MAX_PER_COLLECTION_TON=600.0
MAX_ITEMS_TOTAL=50
MAX_ITEMS_PER_COLLECTION=10
DAILY_LOSS_LIMIT_TON=50.0
MAX_HOLDING_HOURS=168

# === SCANNER ===

REQUEST_DELAY_SECONDS=2.5
COLLECTIONS_REFRESH_MINUTES=5
SCAN_INTERVAL_SECONDS=60.0

# === STRATEGIES ===

CROSS_MARKET_ENABLED=true
ORDER_ARB_ENABLED=false
DEEP_DISCOUNT_ENABLED=true
PRICE_DROP_THRESHOLD=0.40

# === DATABASE POOL ===

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# === FALLING PRICE (Getgems "Падающая цена") ===
# Enable Dutch-auction style listings on Getgems
FALLING_PRICE_ENABLED=false
# Decrease interval in ms: 300000=5m, 3600000=1h, 86400000=1d
FALLING_PRICE_INTERVAL_MS=3600000
# Price decrease per interval (% of start price)
FALLING_PRICE_DECREASE_PCT=3.0

# === SHADOW MODE ===
# ALWAYS start with true — no real money until validated
SHADOW_MODE=true
